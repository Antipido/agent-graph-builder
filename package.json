{
  "name": "agent-graph-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "docker:build": "docker build -t agent-graph-builder .",
    "docker:run": "docker run --rm -p 3210:8080 --name agent-graph-builder agent-graph-builder",
    "docker:up": "docker compose up --build -d",
    "docker:dev": "docker compose --profile dev up --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@xyflow/react": "^12.12.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
